<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Student Management"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentManagement">

        <activity android:name=".profile.ProfileActivity" />
        <activity android:name=".dashboard.DashboardActivity" />
        <activity android:name=".dashboard.FacultyDashboardActivity" />
        <activity android:name=".dashboard.AdminDashboardActivity" />
        <activity android:name=".dashboard.ManageStudentsActivity" />
        <activity android:name=".dashboard.ManageFacultyActivity" />
        <activity android:name=".dashboard.CreateFacultyActivity" />
        <activity android:name=".dashboard.FacultyCoursesActivity" />
        
        <!-- Member 3 Activities -->
        <activity android:name=".dashboard.ManageCoursesActivity" />
        <activity android:name=".dashboard.CourseDetailActivity" />
        <activity android:name=".assignment.FacultyAssignmentListActivity" />
        <activity android:name=".assignment.CreateAssignmentActivity" />
        <activity android:name=".dashboard.StudentCoursesActivity" />
        
        <activity android:name=".faculty.FacultyStudentsActivity" />
        <activity android:name=".faculty.FacultyAttendanceActivity" />
        <activity android:name=".dashboard.StudentAttendanceActivity" />
        
        <activity android:name=".auth.RegisterActivity" />
        <activity android:name=".auth.LoginActivity" />
        <activity android:name=".assignment.AssignmentActivity" />
        <activity android:name=".assignment.AssignmentDetailsActivity" />
        <activity android:name=".notification.NotificationActivity" />
        <activity
            android:name=".auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
